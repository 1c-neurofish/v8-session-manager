# v8-session-manager — опознание баз для контура маскирования через RAS
# кластера 1С. Все переменные опциональны; пароль никогда не логируется.

# Путь к исполняемому `rac` платформы 1С.
# V8SM_RAC_PATH=/opt/1cv8/current/rac

# Фиксированный адрес RAS (host:port). Без него `rac` вызывается по
# `cluster_server` (Srvr строки соединения) как есть — порт rmngr в Srvr
# (например 1541) не является портом RAS, поэтому для серверных баз
# переменную нужно задать.
# V8SM_RAS_ADDRESS=ras.example.local:1545

# Учётные данные кластера 1С для rac. Пустые/отсутствующие значения —
# штатная схема "RAS без пароля": флаги --cluster-user/--cluster-pwd
# в этом случае не передаются.
# V8SM_RAS_CLUSTER_USER=
# V8SM_RAS_CLUSTER_PASSWORD=
